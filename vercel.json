{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/sign-in",
      "destination": "/frontend/"
    },
    {
      "source": "/sign-in/(.*)",
      "destination": "/frontend/"
    },
    {
      "source": "/sign-up",
      "destination": "/frontend/"
    },
    {
      "source": "/sign-up/(.*)",
      "destination": "/frontend/"
    },
    {
      "source": "/history",
      "destination": "/frontend/"
    },
    {
      "source": "/history/(.*)",
      "destination": "/frontend/"
    },
    {
      "source": "/stats",
      "destination": "/frontend/"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ],
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ]
}
