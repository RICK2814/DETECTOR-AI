# -- AI Detector Backend ------------------------------
# Copy this file to .env and fill in your values

# Server
PORT=4000
NODE_ENV=development

# Groq API key (for AI detection - console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
FRONTEND_URL=http://localhost:5173

# Clerk (https://dashboard.clerk.com) - same instance as the frontend app
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Optional (local only): set to 1 if you want Clerk auth strictly enforced on localhost.
# LOCAL_CLERK_AUTH=0