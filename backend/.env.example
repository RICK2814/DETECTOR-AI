# ── AI Detector Backend ──────────────────────────────────
# Copy this file to .env and fill in your values

# Server
PORT=4000
NODE_ENV=development

# Groq API key (for AI detection — console.groq.com)
GROQ_API_KEY=your_groq_key_here
# Optional: Google Fact Check Tools Claim Search API key (enable API in Google Cloud first)
GOOGLE_FACT_CHECK_API_KEY=
# Active Groq model for text analysis (supported on Developer plan)
GROQ_MODEL=openai/gpt-oss-120b

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Clerk (https://dashboard.clerk.com) — same instance as the frontend app
CLERK_SECRET_KEY=sk_test_your_secret_key_here
